# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit file ".env" ke GitHub.

# Kunci rahasia session Flask, isi string acak apa saja
SECRET_KEY=ganti-dengan-string-acak-yang-panjang

# Nama Storage bucket Firebase, contoh: binar-cerdas.appspot.com
FIREBASE_STORAGE_BUCKET=

# --- Kredensial Firebase: pilih SALAH SATU cara di bawah ---

# Cara A (development lokal): taruh file JSON service account di root
# project dengan nama serviceAccountKey.json, tidak perlu isi baris ini.
FIREBASE_CREDENTIALS=serviceAccountKey.json

# Cara B (production / Vercel): tempel SELURUH isi file JSON service account
# di sini sebagai satu baris string. Kosongkan kalau pakai Cara A.
FIREBASE_CREDENTIALS_JSON=
